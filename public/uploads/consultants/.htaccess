Options -Indexes

# Block PHP execution in upload directories
<FilesMatch "\.(php|php3|php4|php5|php7|phtml|pl|py|cgi|sh)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Only allow image files
<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg)$">
    Order deny,allow
    Allow from all
</FilesMatch>
